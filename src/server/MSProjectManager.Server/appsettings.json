{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Při nasazení nastavit na hostname VM — brání útokům přes hlavičku Host.
  "AllowedHosts": "*",

  // Relativní cesty se rozhodují proti složce, ze které služba běží.
  // Obojí musí být zapisovatelné; pod Program Files nastavit absolutní cestu
  // do %ProgramData%\MSProjectManager\.
  "Database": {
    "Path": "data/msprojectmanager.db"
  },

  // Key ring, kterým se šifruje ADO PAT (ADR-008). Zálohovat spolu s databází:
  // bez klíčů jsou uložené PATy nedešifrovatelné.
  "DataProtection": {
    "KeysPath": "keys"
  },

  "Auth": {
    "SessionHours": 8,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RequireHttps": true
  },

  // Strop na jednu příchozí SignalR zprávu. Výchozích 32 kB nestačí na
  // `full_state_import`, který nese celý stav projektu jako jeden příkaz.
  "Hub": {
    "MaxMessageSizeBytes": 4194304
  },

  "Actors": {
    "PersistIntervalSeconds": 5,
    "IdleTimeoutMinutes": 15,
    "MaxQueueLength": 1000
  }
}
