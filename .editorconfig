root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# ── TypeScript / JavaScript ──────────────────────────────────────────────────
# Formátování řeší Biome (biome.json) — tohle je jen pro editory bez Biome pluginu.
[*.{ts,tsx,js,jsx,json}]
indent_size = 2
max_line_length = 100

# ── F# — konfigurace Fantomas ────────────────────────────────────────────────
# Fantomas čte .editorconfig; tohle je jediný zdroj pravdy pro formát F# kódu.
# Agent ani člověk o formátování nerozhoduje — `./build/build.sh format` to srovná.
[*.{fs,fsi,fsx}]
indent_size = 4
max_line_length = 120

fsharp_space_before_uppercase_invocation = false
fsharp_space_before_class_constructor = false
fsharp_space_before_member = false
fsharp_space_before_colon = false
fsharp_space_after_comma = true
fsharp_space_before_semicolon = false
fsharp_space_after_semicolon = true
fsharp_space_around_delimiter = true

# Vícenásobné argumenty a záznamy na samostatných řádcích — čitelnější diffy
fsharp_multiline_bracket_style = aligned
fsharp_multi_line_lambda_closing_newline = true
fsharp_keep_max_number_of_blank_lines = 2

# Zarovnání pattern matchů — u reducerů (applyCommand) zásadní pro čitelnost
fsharp_bar_before_discriminated_union_declaration = true
fsharp_experimental_keep_indent_in_branch = true

[*.{csproj,fsproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
